DATABASE_URL=mongodb://localhost:27017/e-dekor
JWT_SECRET=your-super-secret-jwt-key

# Google Maps API Key for geolocation features
Maps_API_KEY=your-google-maps-api-key

# VAPID Keys for Push Notifications
# Generate these using `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:your-email@example.com

# Backend CORS configuration (comma separated list of origins)
# Example: https://your-app.vercel.app
ALLOWED_ORIGINS=

# Frontend API URL (for Vercel environment)
REACT_APP_API_URL=https://your-backend-on-koyeb.koyeb.app
REACT_APP_VAPID_PUBLIC_KEY=
